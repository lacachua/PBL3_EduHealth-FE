VITE_API_BASE_URL=
# Leave this empty in local Vite dev if you want to rely on the /api proxy.
# Do not leave trailing spaces after "=".
VITE_DEV_API_PROXY_TARGET=http://localhost:5054
VITE_APP_NAME=EduHealth

# Data source mode: live | mock | hybrid
# Use hybrid if only some modules should stay on mock while the rest remain live.
VITE_DATA_MODE=hybrid

# Admin modules
VITE_ENABLE_ADMIN_USERS_MOCK=false
VITE_ENABLE_ADMIN_STUDENTS_MOCK=false
VITE_ENABLE_ADMIN_CATALOGS_MOCK=true
VITE_ENABLE_ADMIN_MEDICINES_MOCK=false
VITE_ENABLE_ADMIN_REPORTS_MOCK=true
VITE_ENABLE_ADMIN_SYSTEM_LOGS_MOCK=true
VITE_ENABLE_ADMIN_SETTINGS_MOCK=true
VITE_ENABLE_ADMIN_DASHBOARD_MOCK=true

# Nurse modules
VITE_ENABLE_NURSE_STUDENTS_MOCK=false
VITE_ENABLE_NURSE_HEALTH_PROFILE_MOCK=false
VITE_ENABLE_NURSE_MEDICINES_MOCK=false
VITE_ENABLE_NURSE_EXAMINATIONS_MOCK=false
VITE_ENABLE_NURSE_VACCINATIONS_MOCK=false
# Cross-role inbox mock for Notifications when BE inbox APIs are still pending.
VITE_ENABLE_NOTIFICATIONS_INBOX_MOCK=false
VITE_ENABLE_NURSE_NOTIFICATIONS_MOCK=false
VITE_ENABLE_NURSE_REPORTS_MOCK=true
VITE_ENABLE_NURSE_DASHBOARD_MOCK=true

# Auth
VITE_ENABLE_AUTH_MOCK=false
VITE_ENABLE_CURRENT_USER_ACCOUNT_MOCK=false
# Student role-3 read APIs are backend-pending, keep this true until BE read endpoints are finalized.
VITE_ENABLE_STUDENT_PORTAL_MOCK=true

# Legacy fallback flags (optional)
VITE_ENABLE_MOCK_AUTH=false
VITE_ENABLE_MOCK_ADMIN_DASHBOARD=false
VITE_ENABLE_MOCK_HEALTH_PROFILES=false
VITE_ENABLE_MOCK_MEDICINES=false
VITE_ENABLE_MOCK_EXAMINATIONS=false
